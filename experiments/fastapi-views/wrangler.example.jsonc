{
  "name": "pw012-fastapi-REPLACE_WITH_RANDOM_SUFFIX",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["python_workers", "python_dedicated_snapshot"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "REPLACE_WITH_DISPOSABLE_DATABASE",
    "database_id": "REPLACE_WITH_DISPOSABLE_DATABASE_UUID"
  }],
  "ratelimits": [{
    "name": "VIEW_LIMITER",
    "namespace_id": "REPLACE_WITH_UNUSED_NAMESPACE",
    "simple": {"limit": 30, "period": 60}
  }],
  "vars": {"SITE_ORIGIN": "https://REPLACE_WITH_DISPOSABLE_WORKER.workers.dev"}
}
