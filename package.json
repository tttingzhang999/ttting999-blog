{
  "name": "ttting999-blog",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate && node scripts/static-policy.mjs && node scripts/build-published-routes.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "node --test --experimental-test-coverage tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck",
    "test:seo-build": "node scripts/check-seo.mjs",
    "blog:status": "node scripts/blog/cli.mjs status",
    "blog:plan": "node scripts/blog/cli.mjs plan",
    "blog:sync": "node scripts/blog/cli.mjs sync",
    "test:blog-build": "node scripts/check-blog-build.mjs",
    "test:static": "playwright test --config playwright.static.config.ts",
    "test:static:serve": "WRANGLER_SEND_METRICS=false wrangler dev --local --config tests/fixtures/static-runtime/wrangler.json --ip 127.0.0.1 --port 8787",
    "test:views": "WRANGLER_SEND_METRICS=false node --test --experimental-test-coverage --test-coverage-include=worker/*.mjs --test-coverage-include=utils/article-views.ts --test-coverage-include=scripts/published-routes.mjs --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/article-views*.test.mjs",
    "release:build": "node scripts/build-release.mjs",
    "test:release": "node --test --experimental-test-coverage --test-coverage-include=scripts/release-artifact.mjs --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/release-artifact.test.mjs",
    "test:handoff": "node --test --experimental-test-coverage --test-coverage-include=scripts/release-transport.mjs --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/ci-handoff.test.mjs tests/release-transport.test.mjs"
  },
  "dependencies": {
    "@nuxt/content": "^3.7.1",
    "@nuxt/image": "^1.11.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/i18n": "^10.1.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@vueuse/motion": "^3.0.3",
    "better-sqlite3": "^12.4.1",
    "fullpage.js": "^4.0.37",
    "gsap": "^3.13.0",
    "nuxt": "^4.1.3",
    "sharp": "^0.34.4",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@nuxtjs/sitemap": "^7.4.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.8.0",
    "sass": "^1.93.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.8.1",
    "slugify": "^1.6.6",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "wrangler": "4.149.0"
  }
}
